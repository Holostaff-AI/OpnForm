# Rig-local throwaway API env for the Holostaff deployment rig.
# Stands in for the api/.env that scripts/setup-env.sh --docker writes.
# The APP_KEY and JWT_SECRET below are the ones this project already
# publishes in docker-compose.dev.yml — they guard an ephemeral test
# database that is dropped (`down -v`) at the start of every run and
# never holds real data.
APP_NAME="OpnForm"
APP_ENV=production
APP_KEY=base64:dD8AFEB45nKZ0VWmIPiW495rDYb+ywRJnCCSdycw0pI=
APP_DEBUG=false
APP_URL=http://localhost:4183
FRONT_URL=http://localhost:4183
SELF_HOSTED=true

LOG_CHANNEL=errorlog
LOG_LEVEL=debug

FILESYSTEM_DRIVER=local
LOCAL_FILESYSTEM_VISIBILITY=public

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

MAIL_MAILER=log
MAIL_FROM_ADDRESS=rig@rig.holostaff.ai
MAIL_FROM_NAME=OpnForm-Rig

JWT_TTL=1440
JWT_SECRET=38hjE96gYu4ceKSSHNnzgeynMr2m3WkNBN2u7zzpVeiITtxFEloxAjcr7TCKuiiy
JWT_SKIP_IP_UA_VALIDATION=true

PUBLIC_UPLOADS_RATE_LIMIT_PER_MINUTE=30
PUBLIC_UPLOADS_RATE_LIMIT_PER_HOUR=300

SHOW_OFFICIAL_TEMPLATES=false
